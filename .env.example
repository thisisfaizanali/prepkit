# Groq API key (primary LLM provider). Required for real LLM calls.
GROQ_API_KEY=
# Groq model id.
GROQ_MODEL=openai/gpt-oss-120b
# Groq tokens-per-minute budget used by the client-side pacer.
GROQ_TPM=8000
# Groq requests-per-minute budget used by the client-side pacer.
GROQ_RPM=30
# Groq reasoning_effort sent with each request: off (omit) | low | medium | high.
GROQ_REASONING_EFFORT=low
# Secondary Groq model (same key, its own TPM/RPM window); takes calls while the primary is pacing. "off" disables it.
GROQ_SECONDARY_MODEL=openai/gpt-oss-20b
# Secondary Groq model tokens-per-minute budget.
GROQ_SECONDARY_TPM=8000
# Secondary Groq model requests-per-minute budget.
GROQ_SECONDARY_RPM=30
# Gemini API key (optional). Enables Gemini as the fallback provider when set.
GEMINI_API_KEY=
# Gemini model id.
GEMINI_MODEL=gemini-3.6-flash
# Gemini tokens-per-minute budget used by the client-side pacer.
GEMINI_TPM=200000
# Gemini requests-per-minute budget used by the client-side pacer.
GEMINI_RPM=10
# Gemini reasoning_effort sent with each request: off (omit) | low | medium | high.
GEMINI_REASONING_EFFORT=low
# Per-request LLM timeout in milliseconds.
LLM_TIMEOUT_MS=60000
# Allow crawling private/loopback addresses (true|false). Defaults to true unless NODE_ENV=production:
# the batch grader serves sites from localhost, but production must block them (SSRF protection).
ALLOW_PRIVATE_URLS=
# Tavily API key (optional). Enables searching public interview discussions; skipped when unset.
TAVILY_API_KEY=
# MongoDB connection string (API server only; npm run evaluate doesn't need it).
MONGODB_URI=
# MongoDB database name (selected explicitly, not taken from the URI).
MONGODB_DB=prepkit
# Optional DNS servers for Node (comma-separated, e.g. 1.1.1.1,8.8.8.8). Only if mongodb+srv lookups fail with querySrv ECONNREFUSED.
DNS_SERVERS=
# API server port.
PORT=4000
# Web app origin for CORS (optional). Leave empty when the web app proxies /api to the API (same origin).
WEB_ORIGIN=
