# Groq API key (primary LLM provider). Required for real LLM calls.
GROQ_API_KEY=
# Groq model id.
GROQ_MODEL=llama-3.3-70b-versatile
# Groq tokens-per-minute budget used by the client-side pacer.
GROQ_TPM=6000
# Gemini API key (optional). Enables Gemini as the fallback provider when set.
GEMINI_API_KEY=
# Gemini model id.
GEMINI_MODEL=gemini-2.5-flash
# Gemini tokens-per-minute budget used by the client-side pacer.
GEMINI_TPM=200000
# Per-request LLM timeout in milliseconds.
LLM_TIMEOUT_MS=60000
